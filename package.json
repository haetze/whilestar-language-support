{
  "name": "whilestar-language-support",
  "displayName": "WhileStar Language Support",
  "description": "WhileStar Language Support",
  "version": "0.0.1",
  "publisher": "assanali-uzakov",
  "icon": "resources/whilestar-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/asanali-uzakov/whilestar-language-support"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "while-star",
        "aliases": [
          "WhileStar",
          "while-star"
        ],
        "extensions": [
          ".wstar"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "while-star",
        "scopeName": "source.while-star",
        "path": "./syntaxes/while-star.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "whileStar.openInterpreter",
        "title": "WhileStar: Open Interpreter"
      },
      {
        "command": "whileStar.run",
        "title": "WhileStar: Run Code"
      },
      {
        "command": "whileStar.debug",
        "title": "WhileStar: Debug Code"
      },
      {
        "command": "whileStar.tc",
        "title": "WhileStar: Type Check Code"
      },
      {
        "command": "whileStar.proof",
        "title": "WhileStar: Proof Check Code"
      },
      {
        "command": "whileStar.livenessAnalysis",
        "title": "WhileStar: Run Liveness Analysis"
      },
      {
        "command": "whileStar.reachabilityAnalysis",
        "title": "WhileStar: Run Reachability Analysis"
      },
      {
        "command": "whileStar.rdAnalysis",
        "title": "WhileStar: Run Reaching Definitions Analysis"
      },
      {
        "command": "whileStar.taintAnalysis",
        "title": "WhileStar: Run Taint Analysis"
      },
      {
        "command": "whileStar.transitionCfg",
        "title": "WhileStar: Show Transition CFG"
      },
      {
        "command": "whileStar.startTutorial",
        "title": "WhileStar: Start Interactive Tutorial"
      },
      {
        "command": "whileStar.startSemanticsTutorial",
        "title": "WhileStar: Start Language Semantics Tutorial"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node ./scripts/build-target.cjs && pnpm run lint",
    "sync:webview": "cp ./src/resources/webview.html ./resources/webview.html",
    "langium:generate": "langium generate",
    "build": "pnpm run build:publish",
    "build:developing": "node ./scripts/build-target.cjs developing",
    "build:publishing": "node ./scripts/build-target.cjs publishing",
    "build:dev": "pnpm run build:developing",
    "build:publish": "pnpm run build:publishing",
    "esbuild-base:developing": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --define:__WIZ_BASE_URL__='\"http://127.0.0.1:8080\"' --define:__WIZ_SERVER_LOCATION__='\"remote\"' --define:__WIZ_SERVER_TYPE__='\"binary\"' --define:__WIZ_SERVER_PORT__='8080'",
    "esbuild-base:publishing": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --define:__WIZ_BASE_URL__='\"https://wiz.cs.tu-dortmund.de\"' --define:__WIZ_SERVER_LOCATION__='\"remote\"' --define:__WIZ_SERVER_TYPE__='\"binary\"' --define:__WIZ_SERVER_PORT__='8080'",
    "esbuild-server": "esbuild ./src/language-server/main.ts --bundle --outfile=out/language-server/main.js --external:vscode --format=cjs --platform=node",
    "package:developing": "node ./scripts/package-target.cjs developing",
    "package:publishing": "node ./scripts/package-target.cjs publishing",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.19.0",
    "eslint": "^9.25.1",
    "langium": "~3.1.0",
    "langium-cli": "~3.1.0",
    "typescript": "^5.8.3",
    "vscode-languageserver": "^9.0.1"
  }
}
